{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_WEB_URL": "http://100.70.234.41:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "sandbox",
      "env": {
        "APP_VARIANT": "sandbox",
        "EXPO_PUBLIC_APP_ENV": "sandbox",
        "EXPO_PUBLIC_WEB_URL": "https://sandbox.learnvianotes.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEB_URL": "https://learnvianotes.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
