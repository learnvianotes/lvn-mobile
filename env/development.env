# Public build-time values for the development variant. Every URL the app uses comes from these files, never from
# code (lvn-backend ADR-0022). Never put secrets here: EXPO_PUBLIC_* values are inlined into the JS bundle. Per-machine overrides go in env/development.local.env (git-ignored).
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
# Phones reach the dev machine at its LAN/VPN address, not localhost.
EXPO_PUBLIC_WEB_URL=http://100.70.234.41:3000
# lvn-backend's GraphQL gateway on the dev machine (`pnpm dev` in lvn-backend).
EXPO_PUBLIC_API_URL=http://100.70.234.41:4000/graphql
# Live updates: unset here means EXPO_PUBLIC_API_URL + /live (lvn-backend ADR-0042)
# GitHub sign-in (public client id; empty hides the button). The redirect URI registered with GitHub and listed in
# the API's OAUTH_REDIRECT_URIS is learnvianotes-dev://oauth/callback.
# EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# Sentry for crashes and unexpected errors (§16.5); empty turns it off.
# EXPO_PUBLIC_SENTRY_DSN=
# Google sign-in (Firebase, ADR-0007): the Firebase web app's config and the OAuth client ids of the project's Google
# provider (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration). Empty hides the button.
# From the Firebase web app's config, set per machine in env/development.local.env (git-ignored, so the key can be
# rotated without a commit):
# EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=learnvianotes-com.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=learnvianotes-com
# EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=268871847112-e7pj3t7a6rvl3vq00t8o8jseshmpih9e.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Firebase Android config for com.learnvianotes.dev (google-services.json, git-ignored). Builds without the file skip it.
GOOGLE_SERVICES_JSON=firebase/development/google-services.json
