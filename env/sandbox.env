# Public build-time values for the sandbox variant (shared staging). No secrets.
APP_VARIANT=sandbox
EXPO_PUBLIC_APP_ENV=sandbox
EXPO_PUBLIC_WEB_URL=https://sandbox.learnvianotes.in
EXPO_PUBLIC_API_URL=https://api.sandbox.learnvianotes.in/graphql
# Redirect URI: learnvianotes-sandbox://oauth/callback
# EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# Sentry for crashes and unexpected errors (§16.5); empty turns it off.
# EXPO_PUBLIC_SENTRY_DSN=
# Google sign-in (Firebase, ADR-0007): the Firebase web app's config and the OAuth client ids of the project's Google
# provider (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration). Empty hides the button.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Firebase Android config for com.learnvianotes.sandbox (google-services.json, git-ignored). Builds without the file skip it.
# GOOGLE_SERVICES_JSON=firebase/sandbox/google-services.json
