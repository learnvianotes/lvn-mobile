# Public build-time values for the production variant. No secrets.
APP_VARIANT=production
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_WEB_URL=https://www.learnvianotes.in
EXPO_PUBLIC_API_URL=https://api.learnvianotes.in/graphql
# Live updates while the app is open (lvn-backend ADR-0042)
EXPO_PUBLIC_LIVE_URL=wss://api.learnvianotes.in/graphql/live
# Redirect URI: learnvianotes://oauth/callback
# EXPO_PUBLIC_GITHUB_CLIENT_ID=
EXPO_PUBLIC_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# Sentry for crashes and unexpected errors (§16.5); empty turns it off.
# EXPO_PUBLIC_SENTRY_DSN=
# Google sign-in (Firebase, ADR-0007). Empty hides the button. Needs a Web client id, API key, auth domain and project id
# (app id optional). The API key must allow Identity Toolkit from the app. Android needs a matching package and SHA-1
# (docs/architecture/mobile-addendum.md). Do not commit the values.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Firebase Android config for com.learnvianotes (google-services.json, git-ignored). Builds without the file skip it.
# GOOGLE_SERVICES_JSON=firebase/production/google-services.json
